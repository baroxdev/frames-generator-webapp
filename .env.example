# Supabase project settings (Project Settings > API in the Supabase dashboard).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudflare Turnstile site key (create a widget at dash.cloudflare.com/?to=/:account/turnstile).
# The matching secret key is configured in the Supabase dashboard under
# Authentication > Attack Protection > Enable CAPTCHA protection, so Supabase
# verifies the token server-side — no custom backend is needed for it.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
