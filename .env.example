# Supabase project settings (Project Settings > API in the Supabase dashboard).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudflare Turnstile site key (create a widget at dash.cloudflare.com/?to=/:account/turnstile).
# The matching secret key is configured in the Supabase dashboard under
# Authentication > Attack Protection > Enable CAPTCHA protection, so Supabase
# verifies the token server-side — no custom backend is needed for it.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Facebook App ID for the owner's "Share to Facebook" button on the campaign
# list (developers.facebook.com > your app > Settings > Basic). The app's
# domain must be added under Settings > Basic > App Domains, and the
# deployed origin(s) (e.g. https://your-app-domain.example) must be listed
# under Facebook Login > Settings > Valid OAuth Redirect URIs, or the Feed
# Dialog will reject the redirect_uri this app sends.
VITE_FACEBOOK_APP_ID=your-facebook-app-id

# GA4 Measurement ID for page-view and event tracking (analytics.google.com >
# Admin > Data Streams > your web stream). Optional — tracking is silently
# disabled if unset, so this can be left out in local dev.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog project API key (app.posthog.com > Project Settings > Project API
# Key), used as a backup analytics destination alongside GA4 — every event
# GA4 receives is also sent here. Optional — tracking is silently disabled
# if unset, so this can be left out in local dev.
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PostHog ingestion host. Defaults to https://us.i.posthog.com if unset; use
# https://eu.i.posthog.com for EU-hosted projects.
VITE_POSTHOG_HOST=https://us.i.posthog.com
